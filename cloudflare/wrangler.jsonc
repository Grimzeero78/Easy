// DocuExtract — Cloudflare Worker deployment
// One Worker = backend API (Hono under /api) + frontend hosting (static SPA assets).
{
  "name": "docuextract",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "20172992aa1049eaa682eef29e337a5d"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct"
  },
  "observability": {
    "enabled": true
  }
}
